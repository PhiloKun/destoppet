{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mochi",
  "version": "0.1.0",
  "identifier": "com.philokun.mochi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Mochi",
        "width": 320,
        "height": 320,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "contentProtected": false
      },
      {
        "label": "settings",
        "title": "Mochi 设置",
        "width": 360,
        "height": 300,
        "resizable": false,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "visible": false,
        "center": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
